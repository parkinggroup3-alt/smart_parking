    {
        "id": "fn_ins_etat",
        "type": "function",
        "z": "81f2f965e4de32a7",
        "name": "INSERT etat",
        "func": "let e = msg.payload;\nif (typeof e === 'string') { try { e = JSON.parse(e); } catch(x) { return null; } }\nlet last = flow.get('lastLibres');\nif (last === e.libres) return null;   // enregistrer seulement si changement\nflow.set('lastLibres', e.libres);\nlet d = JSON.stringify(e).replace(/'/g, \"''\");\nmsg.topic = \"INSERT INTO historique (ts,type,details) VALUES (\" + Date.now() + \",'etat','\" + d + \"')\";\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 400,

        "type": "function",
        "z": "81f2f965e4de32a7",
        "name": "calcul etat",
        "func": "let p = msg.payload;\nif (typeof p === 'string') { try { p = JSON.parse(p); } catch(e) { return null; } }\nlet places = [p.p1, p.p2, p.p3];\nlet libres = places.filter(x => x === \"libre\").length;\nflow.set(\"libres\", libres);\nmsg.payload = {libres: libres, places: places, complet: libres === 0};\nreturn msg;",
